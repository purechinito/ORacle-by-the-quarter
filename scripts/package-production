#!/usr/bin/env python3
"""Build a secret-free production release; the database is transferred separately."""
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile

root = Path(__file__).resolve().parents[1]
subprocess.run(['npm', 'ci', '--ignore-scripts'], cwd=root / 'web', check=True)
subprocess.run(['npm', 'run', 'build'], cwd=root / 'web', check=True)
directory = Path(tempfile.mkdtemp(prefix='production-', dir=root / '.runtime'))
directory.chmod(0o700)
deployment_files = ('Caddyfile', 'Dockerfile', 'backup-lifecycle.json',
                    'bootstrap-vm.sh', 'compose.yaml', 'configure-proxy.py',
                    'create-cloud-resources.sh', 'data-check.py', 'erpctl',
                    'restore.py', 'storage-upload.py',
                    'superq-erp-backup.service', 'superq-erp-backup.timer')
for name in deployment_files:
    source = root / 'infra/production' / name
    shutil.copy2(source, directory / source.name)
shutil.copy2(root / 'infra/versions.json', directory / 'versions.json')
context = directory / 'build'
shutil.copytree(root / 'apps/quarter_erp', context / 'apps/quarter_erp',
                ignore=shutil.ignore_patterns('__pycache__', '*.pyc', '*.egg-info'))
shutil.copy2(directory / 'Dockerfile', context / 'Dockerfile')
shutil.copy2(directory / 'configure-proxy.py', context / 'configure-proxy.py')
page = context / 'apps/quarter_erp/quarter_erp/www/orbit.html'
html = page.read_text()
for name in ['orbit.js', 'orbit.css']:
    asset = context / 'apps/quarter_erp/quarter_erp/public/workspace' / name
    version = hashlib.sha256(asset.read_bytes()).hexdigest()[:16]
    html = html.replace(name + '"', name + '?v=' + version + '"')
page.write_text(html)
base = 'frappe/erpnext@' + json.loads((directory / 'versions.json').read_text())['images']['frappe/erpnext']['digest']
digest = hashlib.sha256(base.encode())
for path in sorted(context.rglob('*')):
    if path.is_file():
        digest.update(str(path.relative_to(context)).encode())
        digest.update(path.read_bytes())
release = {'image': 'superq-erp:' + digest.hexdigest()[:16], 'base_image': base,
           'source_commit': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip(),
           'context_sha256': digest.hexdigest()}
(directory / 'release.json').write_text(json.dumps(release, indent=2) + '\n')
(directory / 'erpctl').chmod(0o755)
archive = directory.with_suffix('.tar.gz')
with tarfile.open(archive, 'w:gz') as target:
    target.add(directory, arcname='superq-erp')
archive.chmod(0o600)
print(json.dumps({'directory': str(directory), 'archive': str(archive), 'image': release['image']}))
