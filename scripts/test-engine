#!/usr/bin/env python3
"""Run the complete current project integration suite against the local engine."""
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
erp = str(root / "scripts/erp")
subprocess.run([sys.executable, str(root / "tests/runtime_smoke.py")], check=True)
source = (root / "tests/test_engine_journeys.py").read_text()
subprocess.run([erp, "exec", "backend", "bash", "-c", "cat > /tmp/orbit_journey_test.py"],
               input=source, text=True, check=True)
subprocess.run([erp, "exec", "backend", "bash", "-c",
               "cd sites && /home/frappe/frappe-bench/env/bin/python /tmp/orbit_journey_test.py"], check=True)
